# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SECRET_KEY=your-secret-key-here-replace-in-production
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/bi_dashboard_dev
REDIS_URL=redis://localhost:6379

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-replace-in-production
NEXTAUTH_URL=http://localhost:3000

# Email Configuration (optional for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# New Relic Monitoring (optional for development)
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=BI-Dashboard-Development

# File Storage (development - use local storage)
# For production, configure AWS S3, Azure Blob, or GCP Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-development-bucket
AWS_REGION=us-east-1

# External APIs (optional for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
SENDGRID_API_KEY=your-sendgrid-api-key

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Development specific
DEBUG=true
LOG_LEVEL=debug

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database Configuration (advanced)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=60000
DB_IDLE_TIMEOUT=600000

# Redis Configuration (advanced)
REDIS_PASSWORD=your-redis-password
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100