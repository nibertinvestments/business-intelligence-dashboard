{
  "name": "business-intelligence-dashboard",
  "version": "1.0.0",
  "description": "Professional Business Intelligence Dashboard - SaaS Analytics Platform with real-time data visualization, multi-tenant architecture, and enterprise-grade monitoring",
  "keywords": [
    "business-intelligence",
    "dashboard",
    "analytics",
    "saas",
    "next.js",
    "typescript",
    "postgresql",
    "real-time",
    "multi-tenant"
  ],
  "homepage": "https://github.com/nibertinvestments/business-intelligence-dashboard",
  "bugs": {
    "url": "https://github.com/nibertinvestments/business-intelligence-dashboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nibertinvestments/business-intelligence-dashboard.git"
  },
  "license": "MIT",
  "author": {
    "name": "Nibert Investments",
    "email": "contact@nibertinvestments.com",
    "url": "https://github.com/nibertinvestments"
  },
  "main": "server.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "env:check": "node scripts/check-env.js",
    "check:deps": "npm audit --audit-level moderate",
    "diagnostics": "node scripts/diagnostics.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "analyze": "cross-env ANALYZE=true next build",
    "lighthouse": "lhci autorun",
    "docker:build": "docker build -t bi-dashboard .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local bi-dashboard",
    "security:audit": "npm audit --audit-level high",
    "security:snyk": "snyk test",
    "performance:test": "k6 run tests/performance/load-test.js",
    "backup:db": "./scripts/backup-database.sh",
    "deploy:staging": "npm run build && npm run db:migrate:deploy",
    "deploy:production": "npm run build && npm run db:migrate:deploy"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "next-auth": "^4.24.8",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.0",
    "redis": "^4.7.0",
    "ioredis": "^5.4.1",
    "@upstash/redis": "^1.34.3",
    "@upstash/ratelimit": "^0.4.4",
    "chart.js": "^4.4.6",
    "react-chartjs-2": "^5.2.0",
    "d3": "^7.9.0",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.13",
    "@headlessui/react": "^2.1.9",
    "@heroicons/react": "^2.1.5",
    "framer-motion": "^11.11.9",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.16",
    "zustand": "^5.0.0",
    "date-fns": "^4.1.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "winston": "^3.15.0",
    "newrelic": "^12.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.6",
    "@types/lodash": "^4.14.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/d3": "^7.4.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "playwright": "^1.48.2",
    "@playwright/test": "^1.48.2",
    "msw": "^2.4.11",
    "@faker-js/faker": "^9.0.3",
    "supertest": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "cross-env": "^7.0.3",
    "@next/bundle-analyzer": "^14.2.15",
    "@lhci/cli": "^0.14.0",
    "snyk": "^1.1293.1",
    "node-mocks-http": "^1.16.1"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}